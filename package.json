{
  "name": "hyperwave-desktop",
  "productName": "HyperWave",
  "version": "0.5.0",
  "upgrade": "pear://e5n4ctw1pr8pk59nrbyoo48mhkrjkne47chckiqh87kh5uxtonny",
  "description": "HyperWave — a worldwide P2P wave of moments (Tether Developers Cup). Electron desktop host at the repo root + the reusable Bare engine and wallets in packages/*; the mobile host in mobile/.",
  "license": "Apache-2.0",
  "author": "",
  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "workspaces": [
    "packages/*",
    "mobile"
  ],
  "scripts": {
    "postinstall": "node scripts/fix-bare-engines.js && node scripts/patch-secret-stream.js && node scripts/build-nsfw.mjs && node scripts/build-qr.mjs",
    "start": "electron-forge start -- --no-updates",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "ota:deploy": "node scripts/ota-deploy.mjs",
    "test": "npm test -w hyperwave-wallet && npm test -w hyperwave-engine && npm test -w hyperwave-wallet-tron && npm test -w hyperwave-wallet-cashu && npm test -w hyperwave-app-core && npm run test:renderer",
    "test:renderer": "node --test \"renderer/lib/*.test.js\"",
    "test:e2e:local": "npm run test:e2e:local -w hyperwave-engine",
    "test:e2e:onchain": "npm run test:e2e:onchain -w hyperwave-engine",
    "test:e2e:onchain:usdt": "npm run test:e2e:onchain:usdt -w hyperwave-engine",
    "test:e2e:cashu": "npm run test:e2e:cashu -w hyperwave-engine",
    "lint": "prettier --check . && lunte packages electron renderer workers scripts && eslint . && npm run lint:jsdoc -w hyperwave-wallet && npm run lint:jsdoc -w hyperwave-engine && npm run lint:jsdoc -w hyperwave-wallet-tron && npm run lint:jsdoc -w hyperwave-wallet-cashu && npm run lint:jsdoc -w hyperwave-app-core",
    "format": "prettier --write . && lunte --fix packages electron renderer workers scripts"
  },
  "overrides": {
    "axios": "1.18.1",
    "ethers": {
      "ws": "8.21.0"
    },
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "xcode": {
      "uuid": "11.1.1"
    },
    "hyperdht": "6.32.0",
    "app-builder-lib": "$app-builder-lib",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@5": "5.0.9",
    "builder-util-runtime": "9.7.0",
    "fast-uri": "3.1.5",
    "ip-address": "10.5.0",
    "js-yaml@3": "3.15.1",
    "js-yaml@4": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "undici@6": "6.28.0",
    "undici@7": "7.29.0"
  },
  "dependencies": {
    "bare-env": "^3.0.1",
    "bare-path": "^3.0.1",
    "bip39": "3.1.0",
    "corestore": "^7.9.1",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperswarm": "^4.17.0",
    "hyperwave-app-core": "^0.5.0",
    "hyperwave-engine": "^0.5.0",
    "hyperwave-wallet-cashu": "^0.4.0",
    "paparam": "^1.10.0",
    "pear-runtime": "^1.1.4",
    "which-runtime": "^1.3.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-msix": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@tensorflow/tfjs": "^4.22.0",
    "app-builder-lib": "^26.15.7",
    "electron": "^40.2.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.0",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.6.0",
    "lunte": "^1.6.0",
    "nsfwjs": "^4.3.0",
    "pear-electron-forge-maker-appimage": "^2.0.0",
    "pear-electron-forge-maker-flatpak": "^0.0.6",
    "pear-electron-forge-maker-snap": "^0.0.10",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "qrcode-generator": "^1.5.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=24"
  },
  "volta": {
    "node": "24.18.0"
  }
}
